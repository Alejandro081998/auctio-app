<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar medio de pago"
            android:letterSpacing="0.04"
            android:textColor="#071827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcionFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Completá los datos requeridos para que la empresa verifique el medio."
            android:textColor="#475569"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spMonedaFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp" />

        <Spinner
            android:id="@+id/spExtranjeraFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtEntidadFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Entidad"
            android:padding="14dp" />

        <EditText
            android:id="@+id/edtReferenciaFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Referencia"
            android:padding="14dp" />

        <LinearLayout
            android:id="@+id/panelDatosTarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_premium"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="DATOS DE TARJETA"
                android:textColor="#A8872F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNumeroTarjeta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Numero de tarjeta"
                android:inputType="number"
                android:maxLength="19"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtNombreTitularTarjeta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Nombre del titular"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtApellidoTitularTarjeta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Apellido del titular"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtVencimientoTarjeta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Vencimiento MM/AA"
                android:inputType="text"
                android:maxLength="5"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtCodigoSeguridadTarjeta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Codigo de seguridad"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:padding="14dp" />

        </LinearLayout>

        <EditText
            android:id="@+id/edtMontoChequeFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input_premium"
            android:hint="Monto certificado"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <TextView
            android:id="@+id/txtMensajeFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="#475569"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGuardarFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_gold"
            android:text="Registrar medio"
            android:textColor="#071827"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline"
            android:text="Volver"
            android:textColor="#0F172A"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
