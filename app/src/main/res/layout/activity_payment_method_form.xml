<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar medio de pago"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescripcionFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Completá los datos requeridos para que la empresa verifique el medio."
            android:textColor="#475569"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/spMonedaFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp" />

        <Spinner
            android:id="@+id/spExtranjeraFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtEntidadFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Entidad"
            android:padding="14dp" />

        <EditText
            android:id="@+id/edtReferenciaFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Referencia"
            android:padding="14dp" />

        <EditText
            android:id="@+id/edtMontoChequeFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Monto certificado"
            android:inputType="numberDecimal"
            android:padding="14dp" />

        <TextView
            android:id="@+id/txtMensajeFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="#475569"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGuardarFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#2563EB"
            android:text="Registrar medio"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverFlujoPago"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E2E8F0"
            android:text="Volver"
            android:textColor="#0F172A"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
