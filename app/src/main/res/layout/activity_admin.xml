<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0E8"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="9dp"
                android:src="@drawable/ic_gavel" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.10"
                    android:text="AUCT.IO"
                    android:textColor="#071827"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="PANEL INTERNO"
                    android:textColor="#A8872F"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_live_chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="ADMIN"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_dark_premium"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Operaciones internas"
                android:textColor="#FFFFFF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMensajeAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Verificacion KYC, medios de pago, consignaciones, catalogo, cierre de lotes y multas."
                android:textColor="#D7E3EF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gold_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="TRAZABILIDAD BACKEND"
                android:textColor="#071827"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="PENDIENTES"
                android:textColor="#A8872F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminActualizarPendientes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_dark"
                android:text="ACTUALIZAR PENDIENTES"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_metric_box"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="Pendientes internos: sin cargar."
                android:textColor="#334155"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/contenedorUsuariosPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.08"
                android:text="MEDIOS DE PAGO PENDIENTES"
                android:textColor="#A8872F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorMediosPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verificacion de usuario"
                android:textColor="#071827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminUsuarioSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_metric_box"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="Selecciona un DNI pendiente para revisar sus datos."
                android:textColor="#334155"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgAdminDniFrente"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_visual_lot"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

                <ImageView
                    android:id="@+id/imgAdminDniDorso"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_visual_lot"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo" />

            </LinearLayout>

            <EditText
                android:id="@+id/edtAdminUsuarioId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de usuario a verificar"
                android:inputType="number"
                android:padding="14dp" />

            <Spinner
                android:id="@+id/spAdminCategoria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnAdminAprobarUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_gold"
                android:text="APROBAR Y ASIGNAR CATEGORIA"
                android:textColor="#071827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminRechazarUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:text="RECHAZAR USUARIO"
                android:textColor="#991B1B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Medios de pago"
                android:textColor="#071827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminMedioSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_metric_box"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="Selecciona un medio pendiente para revisar sus datos."
                android:textColor="#334155"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtAdminMedioPagoId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de medio de pago"
                android:inputType="number"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnAdminVerificarMedio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_gold"
                android:text="VERIFICAR MEDIO DE PAGO"
                android:textColor="#071827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminRechazarMedio"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:text="RECHAZAR MEDIO DE PAGO"
                android:textColor="#991B1B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consignaciones"
                android:textColor="#071827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAdminProductoId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de producto o consignacion"
                android:inputType="number"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtAdminMotivoRechazo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Motivo de rechazo, si aplica"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnAdminAceptarProducto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_gold"
                android:text="ACEPTAR CONSIGNACION"
                android:textColor="#071827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAdminRechazarProducto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:text="RECHAZAR CONSIGNACION"
                android:textColor="#991B1B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Catalogo y cierre"
                android:textColor="#071827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAdminSubastaId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de subasta"
                android:inputType="number"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtAdminPrecioBase"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Precio base definido por la empresa"
                android:inputType="numberDecimal"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtAdminComision"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Comision"
                android:inputType="numberDecimal"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnAdminAsignarProducto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_dark"
                android:text="ASIGNAR PRODUCTO A SUBASTA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAdminItemId"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de item o lote"
                android:inputType="number"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnAdminCerrarItem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_dark"
                android:text="CERRAR ITEM Y GENERAR VENTA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_premium"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Multas por impago"
                android:textColor="#071827"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAdminClienteMulta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_premium"
                android:hint="ID de cliente para multa"
                android:inputType="number"
                android:padding="14dp" />

            <EditText
                android:id="@+id/edtAdminMontoMulta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_premium"
                android:hint="Monto de multa"
                android:inputType="numberDecimal"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnAdminCrearMulta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_outline"
                android:text="CREAR MULTA POR IMPAGO"
                android:textColor="#991B1B"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnVolverAdmin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_dark"
            android:text="CERRAR SESION"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
