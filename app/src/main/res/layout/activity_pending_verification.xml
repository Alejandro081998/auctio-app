<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificación pendiente"
            android:textAlignment="center"
            android:textColor="#0F172A"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDocumentoPendiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Solicitud recibida"
            android:textAlignment="center"
            android:textColor="#475569"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La empresa está revisando tu identidad, domicilio legal y documentación. Cuando seas aprobado, vas a poder generar tu clave personal y registrar medios de pago."
                android:textColor="#475569"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Estado actual: esperando verificación externa"
                android:textColor="#A8872F"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCompletarClavePendiente"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#C5A059"
            android:text="Ya fui aprobado, generar clave"
            android:textColor="#071827"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverLoginPendiente"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E2E8F0"
            android:text="Volver al login"
            android:textColor="#071827"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
